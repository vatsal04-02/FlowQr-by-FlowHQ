{
	email {$ACME_EMAIL}
	# staging mounts deploy/staging/tls_mode/ (local_certs); production mounts nothing => real ACME certificates
	import tls_mode/*
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# flowqr.co.in : marketing site (home + pricing). Everything else lives on the app domain.
{$MARKETING_DOMAIN} {
	import security_headers
	encode zstd gzip
	# every public marketing page and its assets (see MARKETING_ROUTES in frontend/src/lib/site.ts; keep the two lists in step)
	@marketing path / /pricing /about /demo /google-business /review-cards /ai-growth-agent /industries /privacy /terms /refund-policy /data-deletion /robots.txt /sitemap.xml /opengraph-image* /icon.svg /favicon.ico /_next/* /marketing/* /brand/* /product/*
	handle @marketing {
		reverse_proxy frontend:3000
	}
	# The marketing pages call exactly three public API endpoints from the browser (live plan prices, support address, demo-request form), same-origin.
	# Without this they would be redirected to the app domain and fail, and the pricing page would show "Talk to us for pricing" instead of the plans. Nothing else of the API is exposed here.
	@marketing_api path /api/v1/billing/plans /api/v1/legal/info /api/v1/public/leads
	handle @marketing_api {
		request_body {
			max_size 64KB
		}
		reverse_proxy api:8000
	}
	handle {
		redir https://{$APP_DOMAIN}{uri} 302
	}
}
www.{$MARKETING_DOMAIN} {
	redir https://{$MARKETING_DOMAIN}{uri} 301
}

# app.flowqr.co.in : customer dashboard + platform admin. The browser calls /api/* on THIS origin
# (first-party session cookies, no CORS); Next.js/Caddy forward it to the API.
{$APP_DOMAIN} {
	import security_headers
	encode zstd gzip
	request_body {
		max_size 2MB
	}
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy frontend:3000
	}
}

# api.flowqr.co.in : API for server-to-server callers (Razorpay webhooks) and external integrations.
{$API_DOMAIN} {
	import security_headers
	request_body {
		max_size 1MB
	}
	@api path /api/*
	handle @api {
		reverse_proxy api:8000
	}
	handle {
		respond "FlowQR API" 200
	}
}

# go.flowqr.co.in : short domain printed on cards / written to NFC tags. Serves ONLY the public card flow.
{$CARD_DOMAIN} {
	import security_headers
	encode zstd gzip
	request_body {
		max_size 64KB
	}
	@card path /c/* /q/* /n/* /r/* /_next/* /favicon.ico
	handle @card {
		reverse_proxy frontend:3000
	}
	@cardapi path /api/v1/public/*
	handle @cardapi {
		reverse_proxy api:8000
	}
	handle {
		redir https://{$APP_DOMAIN}{uri} 302
	}
}
