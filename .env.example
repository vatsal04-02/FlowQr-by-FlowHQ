# ======================= FlowQR by FlowHQ - environment =======================
# Copy to .env and fill in. NEVER commit .env. Generate secrets as noted.

APP_ENV=development                # development | staging | production. staging/production enable the strict config guard
# openssl rand -hex 32
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Database (docker compose) ---
POSTGRES_PASSWORD=                 # table-owner role "flowqr" (migrations only)
APP_DB_PASSWORD=                   # runtime role "flowqr_app" (non-superuser => RLS enforced). Use letters/digits.

# --- Public URLs ---
FRONTEND_URL=http://localhost:3000
# Base URL encoded into every QR/NFC card. Choose carefully: printed cards live for years.
PUBLIC_CARD_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false                # true in production (HTTPS)

# --- Platform admins (comma separated emails that become FlowHQ admins on registration) ---
PLATFORM_ADMIN_EMAILS=

# --- Google OAuth + Business Profile (leave empty until you have credentials) ---
# Create an OAuth client in Google Cloud Console, enable the Business Profile APIs, and request access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/google/callback
REVIEW_SYNC_INTERVAL_MINUTES=30

# --- "Continue with Google" sign-in (leave empty until you have credentials; the button then reports 'not available yet') ---
# A SEPARATE OAuth client from the Business Profile one above (scopes: openid email profile only; no Google review needed).
# Authorised redirect URI in Cloud Console must equal GOOGLE_LOGIN_REDIRECT_URI exactly (https://<APP_DOMAIN>/api/v1/auth/google/callback in prod).
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# --- AI --- powers Review Growth drafts and reply drafting. AI_PROVIDER = gemini | openrouter | openai_compat.
# No key = customers simply write their own review (nothing breaks).
AI_PROVIDER=gemini
AI_TIMEOUT_SECONDS=25
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# OpenRouter: https://openrouter.ai/models  (a ":free" model needs no credits but has daily limits). Server-side only.
# Any OpenAI-compatible endpoint (AI_PROVIDER=openai_compat): handy free tiers for development, e.g. Groq or Mistral. Use a paid plan for real customers.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_NAME=openai_compat
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Dev only. Leave empty in production. PEM with EXTRA trusted roots if an antivirus/proxy re-signs HTTPS to openrouter.ai.
AI_EXTRA_CA_BUNDLE=

# --- Review Growth (all optional; these are the defaults) ---
REVIEW_SESSION_RETENTION_DAYS=90     # customer answers + drafts are deleted after this many days; aggregate counts are kept
REVIEW_MAX_ATTEMPTS=3                # write + check + up to 2 rewrites if a draft fails its checks
REVIEW_VERIFY_WITH_AI=true           # 2nd AI call fact-checks every draft against the customer's answers (doubles AI calls; fails closed)
REVIEW_MAX_DRAFTS_PER_SESSION=5     # AI drafts one customer may request (1 generation + 4 rewrites)
RL_REVIEW_GENERATE_PER_10MIN=20       # AI requests per visitor IP per campaign per 10 minutes

# --- Razorpay (use rzp_test_ keys until you go live; empty = billing shows 'configuration pending') ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks -> add https://api.flowqr.co.in/api/v1/billing/razorpay/webhook with this secret.
# Events: subscription.* , payment.captured , payment.failed , order.paid
RAZORPAY_WEBHOOK_SECRET=
TRIAL_DAYS=14
CARD_PRICE_PAISE=                  # per physical card in INR paise, e.g. 19900 = Rs 199. EMPTY = card ordering disabled. No default on purpose.
REQUIRE_VERIFIED_EMAIL=true

# --- Production reverse proxy (Caddy): four public hostnames ---
MARKETING_DOMAIN=flowqr.co.in
APP_DOMAIN=app.flowqr.co.in
API_DOMAIN=api.flowqr.co.in
CARD_DOMAIN=go.flowqr.co.in
ACME_EMAIL=
# Public marketing origin baked into the frontend BUILD (canonical links, social cards, sitemap). Rebuild the frontend after changing it.
NEXT_PUBLIC_SITE_URL=https://flowqr.co.in

# --- Email (invitations + password reset). Empty SMTP_HOST = emails are NOT sent. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FlowQR <no-reply@yourdomain.in>

# Local rank tracking: provider id and its API key (keep the key out of git; restrict it in Google Cloud)
RANK_PROVIDER=
RANK_PROVIDER_KEY=

# --- Operations (all optional, the admin Operations page shows what is missing) ---
# Error reporting for API, worker and scheduler (Sentry or a compatible service). Empty = errors are only written to logs.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Platform-wide monthly AI spend (USD). 0 = no budget: the dashboard warns at 80% and flags at 100% once you set one.
AI_MONTHLY_BUDGET_USD=0
# Only needed when your AI provider does not report cost per call (Gemini direct). USD per 1M tokens, from the provider's price list.
AI_PRICE_IN_PER_MTOK=0
AI_PRICE_OUT_PER_MTOK=0
# --- Backups (read by deploy/backup.sh) ---
# BACKUP_PASSPHRASE_FILE: file holding the encryption passphrase (keep a copy OFF the server). BACKUP_REMOTE: where encrypted copies go:
#   a directory/mount, user@host:/path (scp), s3://bucket/prefix (aws cli) or rclone:remote:path
BACKUP_PASSPHRASE_FILE=
BACKUP_REMOTE=

# --- AI cost control (Phase 0). Every model call is recorded in ai_call_ledger and checked against these BEFORE it is made, retries included.
# 0 = no limit of that kind. A USD limit needs the per-token prices; with a limit set and no price, generation is blocked (fail closed).
# Customer-facing review writing stops only at the platform hard limit; drafts, posts and the growth agent stop at the soft line (AI_PLATFORM_SOFT_PCT).
# AI_PLATFORM_HARD_LIMIT_USD=0
# AI_PLATFORM_MONTHLY_TOKEN_LIMIT=0
# AI_PLATFORM_SOFT_PCT=90
# AI_TENANT_MONTHLY_BUDGET_USD=0       # default per business; one business can have its own in tenants.ai_monthly_budget_usd
# AI_TENANT_MONTHLY_TOKEN_BUDGET=0
# AI_REVIEW_RISK_CHECK=true            # an AI safety read of each review when a reply is drafted (on top of the deterministic rules)

# --- Balanced Autonomy (Phase 1). Autonomy is OFF for every business until its owner turns it on; Level 3 changes always need the owner.
# AUTONOMY_EMERGENCY_STOP=false        # true = NO approved or autonomous profile write runs, and scheduled posts/photos/reply retries hold (nothing is lost). A platform admin
#                                      #   can also flip this at runtime (PUT /admin/autonomy/emergency-stop) without a restart.
# AUTONOMY_FAILURE_SUSPEND=3           # consecutive failed executions after which a business's autonomy is suspended until its owner resumes it
# AUTONOMY_MAX_ATTEMPTS=4              # attempts per action for temporary Google errors
# AUTONOMY_APPROVAL_TTL_HOURS=72       # a person's approval stops being valid after this long
# AUTONOMY_AUTO_AUTH_TTL_HOURS=24      # an automatic (policy / pre-authorised) authorisation stops being valid after this long
# AUTONOMY_PROPOSAL_TTL_DAYS=7         # a proposal nobody decides on expires
# AUTONOMY_HISTORY_RETENTION_DAYS=730 # finished actions + their tamper-evident history are erased (whole) after this long; 0 = until the business is deleted (docs/DATA_RETENTION.md)
# RANK_GRID_RETENTION_DAYS=400        # geo-grid scans and points; 0 = keep
# RANK_PLATFORM_MONTHLY_CAP=0         # Places searches the WHOLE platform may spend per month across every business (0 = no platform cap). Each map point is one search.
# RANK_COST_PER_CALL_USD=0            # your Places price per search, so the app can show estimated spend (0 = unpriced: counts only)
# Per-plan map limits (maps per location, points per map, points per month) are NOT environment variables: an administrator sets them per plan in Admin > Plans.
# Maps stay OFF (fail closed) for a plan until all three are set. Final numbers are an owner decision: docs/COMMERCIAL_LIMITS_AND_COSTS.md
# RANK_MAX_KEYWORDS_PER_LOCATION=10  # PROVISIONAL: search terms one location may track
# RANK_MONTHLY_CHECK_CAP=300          # PROVISIONAL: Places searches one business may spend per month on keyword checks
# RANK_RADIUS_M=3000 / RANK_AUTO_CHECK_DAYS=7 / RANK_GRID_MIN_SPACING_M=250 / RANK_GRID_MAX_SPACING_M=10000 / RANK_GRID_AUTO_DAYS=7

# --- Phase 2: prices, costs and promotion (docs/ENVIRONMENT_VARIABLES.md). Everything here is optional; unset = shown as MISSING in Admin > Finance, never as zero.
# API_PRICES={"places.searchText": 0.032}   # USD per unit from YOUR Google Cloud billing, not from memory. Empty = every call is recorded as unpriced.
# USD_INR_RATE=                              # needed to put USD API cost next to INR revenue
# PAYMENT_FEE_PCT=                           # your payment provider's fee, percent of each captured payment
# CARD_UNIT_COST_INR=                        # PROVISIONAL: about 75 was an estimate; packaging, shipping and fulfilment are not confirmed
# CARD_FULFILMENT_PER_ORDER_INR=
# HOSTING_MONTHLY_INR=
# SUPPORT_MONTHLY_INR=
# MARKETING_SPEND_MONTHLY_INR=
# PROMO_CARD_DAYS=30                         # OWNER DECISION PENDING: how long 'one month' of free Growth is
# PROMO_MAX_GRANTS_PER_BUSINESS=1            # OWNER DECISION PENDING: a second card order earns a second free month only if raised
